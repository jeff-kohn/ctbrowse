* text=auto

# Source and build/config files: keep LF across platforms.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.ixx text eol=lf
*.cppm text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.wxui text eol=lf

# Scripts
*.ps1 text eol=lf
*.sh text eol=lf

# Patch files must remain LF for reliable application in CI.
*.patch text eol=lf
*.diff text eol=lf

# Windows shell scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.pdf binary