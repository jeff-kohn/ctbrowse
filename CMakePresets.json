{
   "version": 9,
   "cmakeMinimumRequired": {
      "major": 3,
      "minor": 25,
      "patch": 0
   },
   "configurePresets": [
      {
         "name": "build-dir",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "installDir": "${sourceDir}/build/${presetName}/install",
         "hidden": true
      },
      {
         "name": "vcpkg-toolchain",
         "hidden": true,
         "condition": {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
         },
         "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": {
               "value": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
               "type": "FILEPATH"
            }
         }
      },
      {
         "name": "vcpkg-win-static",
         "hidden": true,
         "inherits": "vcpkg-toolchain",
         "cacheVariables": {
            "VCPKG_TARGET_TRIPLET": "win-static",
            "CTB_MSVC_RUNTIME_LIBRARY": "$<$<CONFIG:Debug>:MultiThreadedDebug>$<$<CONFIG:Release,RelWithDebInfo>:MultiThreaded>"
         }
      },
      {
         "name": "vcpkg-win-clang",
         "hidden": true,
         "inherits": "vcpkg-win-static",
         "cacheVariables": {
            "VCPKG_TARGET_TRIPLET": "win-clang"
         }
      },
      {
         "name": "win-msvc",
         "displayName": "Windows-MSVC",
         "description": "Build preset for Windows with MSVC",
         "inherits": [ "build-dir", "vcpkg-win-static" ],
         "generator": "Visual Studio 18 2026",
         "architecture": "x64",
         "toolset": "v145",
         "cacheVariables": {
            "CTB_BUILD_TESTS": "OFF",
            "CTB_USE_PRECOMPILED_HEADERS": "ON"
         },
         "vendor": {
            "microsoft.com/VisualStudioSettings/CMake/1.0": {
               "intelliSenseMode": "windows-msvc-x64"
            }
         }
      },
      {
         "name": "win-clang",
         "$comment": "clang-tidy doesn't get along with multi-config generators or PCH so its disabled",
         "displayName": "Windows-Clang",
         "description": "Build preset for Clang on Windows",
         "inherits": [ "build-dir", "vcpkg-win-clang" ],
         "generator": "Ninja Multi-Config",
         "cacheVariables": {
            "CMAKE_CXX_COMPILER": "clang-cl",
            "CTB_BUILD_TESTS": "OFF",
            "CTB_CLANG_TIDY_BUILD_SCAN": "OFF",
            "CTB_CLANG_TIDY_PROJECT_SCAN": "OFF",
            "CTB_USE_PRECOMPILED_HEADERS": "ON"
         },
         "architecture": {
            "value": "x64",
            "strategy": "external"
         },
         "toolset": {
            "strategy": "external",
            "value": "Clang"
         },
         "vendor": {
            "microsoft.com/VisualStudioSettings/CMake/1.0": {
               "intelliSenseMode": "windows-clang-x64"
            }
         }
      },
      {
         "name": "ci-static-analysis",
         "$comment":  "This preset only supports Release config so that we can run-clang-tidy without it scanning files multiple times",
         "displayName": "Static Analysis",
         "description": "Preset for clang-tidy and CppCheck project scan",
         "inherits": [ "win-clang" ],
         "cacheVariables": {
            "CMAKE_CONFIGURATION_TYPES": "Release",
            "CTB_CLANG_TIDY_PROJECT_SCAN": "ON",
            "CTB_RUN_CLANG_TIDY_JOBS": "4"
         }
      }
   ],
   "buildPresets": [
      {
         "name": "win-msvc-debug",
         "displayName": "Debug",
         "configurePreset": "win-msvc",
         "jobs": 16
      },
      {
         "name": "win-msvc-release",
         "displayName": "Release",
         "configurePreset": "win-msvc",
         "configuration": "Release",
         "jobs": 16
      },
      {
         "name": "win-clang-release",
         "displayName": "Release",
         "configurePreset": "win-clang",
         "configuration": "Release"
      },
      {
         "name": "win-clang-debug",
         "displayName": "Debug",
         "configurePreset": "win-clang",
         "configuration": "Debug"
      },
      {
         "name": "ci-static-analysis",
         "displayName": "Release",
         "configurePreset": "ci-static-analysis",
         "configuration": "Release"
      }
   ]
}
