Checks: "clang-diagnostic-*,cppcoreguidelines-*,modernize-*,cert-*, bugprone-*, readability-*, \
  -cppcoreguidelines-owning-memory, \
  -bugprone-easily-swappable-parameters, \
  -clang-analyzer-optin.core.EnumCastOutOfRange, \
  -cppcoreguidelines-avoid-const-or-ref-data-members, \
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access, \
  -modernize-use-trailing-return-type, \
  -modernize-use-nodiscard,\
  -modernize-use-designated-initializers, \
  -readability-redundant-member-init, \
  -readability-identifier-length, \
  -readability-braces-around-statements, \
  -readability-use-concise-preprocessor-directives, \
  -readability-else-after-return, \
  -readability-implicit-bool-conversion, \
  -readability-else-after-return, \
  -readability-convert-member-functions-to-static, \
  -readability-simplify-boolean-expr, \
  -readability-static-accessed-through-instance,
  -readability-make-member-function-const, \
  -readability-use-anyofallof, \
  -bugprone-throwing-static-initialization,-cert-err58-cpp, \  
  -readability-named-parameter"


WarningsAsErrors: ''

CheckOptions:
  - key: bugprone-exception-escape.IgnoredExceptions
    value: "bad_array_new_length,bad_cast,format_error,std::bad_alloc,bad_alloc"
  - key: 'bugprone-misplaced-widening-cast.CheckImplicitCasts'
    value: 'true'
  - key: 'bugprone-sizeof-expression.WarnOnSizeOfIntegerExpression'
    value: 'true'
  - key: 'bugprone-suspicious-string-compare.WarnOnLogicalNotComparison'
    value: 'true'
  - key: 'cppcoreguidelines-init-variables.MathHeader'
    value: '<cmath>'
  - key: 'cppcoreguidelines-narrowing-conversions.PedanticMode'
    value: 'true'
  - key: 'readability-simplify-boolean-expr.ChainedConditionalReturn'
    value: 'true'
  - key: 'readability-simplify-boolean-expr.ChainedConditionalAssignment'
    value: 'true'
  - key: 'readability-uniqueptr-delete-release.PreferResetCall'
    value: 'true'
  - key: 'readability-else-after-return.WarnOnUnfixable'
    value: 'true'
  - key: 'readability-else-after-return.WarnOnConditionVariables'
    value: 'true'
  - key: 'readability-inconsistent-declaration-parameter-name.Strict'
    value: 'true'
  - key: 'readability-qualified-auto.AddConstToQualified'
    value: 'true'
  - key: 'readability-redundant-access-specifiers.CheckFirstDeclaration'
    value: 'true'

ExcludeHeaderFilterRegex: '.*/(3rdParty|build)/.*'
HeaderFilterRegex:        '.*[/\\][^/\\]*(ctBrowse|ctb)[^/\\]*[/\\].*'

# Disable clang's typo correction. When a TU has compile errors (e.g. clang-tidy parsing without the PCH),
# clang attaches "did you mean X?" fix-its to them, and 'run-clang-tidy -fix' applies them, silently replacing
# valid identifiers with unrelated look-alikes (wxStaticBoxSizer -> wxStaticBoxBase, etc).
# (Must be in ExtraArgsBefore: ExtraArgs are appended after the '--' in compile_commands.json and get treated as file names.)
ExtraArgsBefore: ['--driver-mode=cl', '-Xclang', '-fno-spell-checking']
